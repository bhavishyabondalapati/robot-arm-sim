<!-- Pick-and-place scene for the SO-101 arm (our file, not from Menagerie). -->
<mujoco model="so101_pick_place">
  <include file="so101.xml"/>

  <statistic center="0.2 0 0.1" extent="0.45"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <global azimuth="150" elevation="-25" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.82 0.82 0.80" rgb2="0.74 0.74 0.72"
      markrgb="0.6 0.6 0.6" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="10 10" reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0.2 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Fixed third-person camera looking at the workspace (used as policy input). -->
    <camera name="front" pos="0.52 -0.34 0.46" xyaxes="0.688 0.725 -0.000 -0.433 0.411 0.802" fovy="45"/>

    <!-- The cube to pick. 3 cm wide, ~30 g. Position is randomized each episode. -->
    <body name="cube" pos="0.2 0 0.015">
      <freejoint name="cube_joint"/>
      <geom name="cube" type="box" size="0.015 0.015 0.015" mass="0.03" rgba="0.85 0.2 0.2 1"
        condim="4" friction="1.5 0.01 0.001" solref="0.01 1"/>
    </body>

    <!-- Place target: a flat visual marker on the floor (no collisions). Moved via mocap. -->
    <body name="target" mocap="true" pos="0.2 0.1 0">
      <geom name="target" type="cylinder" size="0.03 0.0005" rgba="0.2 0.7 0.3 0.6" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
